      <column caption='Sales' datatype='real' name='[Calculation_0295740168937472]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Quantity] * [Price]' />
      </column>
      <column caption='Total Orders' datatype='integer' name='[Calculation_0295740170747905]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([Invoice])' />
      </column>
      <column caption='Total Units Sold' datatype='integer' name='[Calculation_0295740464844802]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Quantity])' />
      </column>
      <column caption='Total Customers' datatype='integer' name='[Calculation_0295740465508355]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([Customer ID])' />
      </column>
      <column caption='Average Order Value' datatype='real' name='[Calculation_0295740465790980]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Quantity] * [Price]) / COUNTD([Invoice])' />
      </column>
      <column caption='Month Start' datatype='datetime' name='[Calculation_0295740467519494]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATETRUNC(&apos;month&apos;, [MonthYear])' />
      </column>
      <column caption='Physical Product' datatype='boolean' name='[Calculation_0295740472004615]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='NOT (&#10;  UPPER([Description]) = &apos;MANUAL&apos;&#10;  OR UPPER([Description]) = &apos;DOTCOM POSTAGE&apos;&#10;  OR UPPER([Description]) = &apos;POSTAGE&apos;&#10;)' />
